# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Frontend / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-nextauth-secret-here
# Must match ENCRYPTION_KEY above
NEXT_PUBLIC_ENCRYPTION_KEY=your-encryption-key-here

# Optional overrides (defaults shown)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_USER=60
RATE_LIMIT_API_CLIENT=100

# Database: "sqlite" (default) or "mongo"
DATABASE_TYPE=sqlite

# Only needed when DATABASE_TYPE=mongo
MONGO_URI=mongodb://user:pass@host:27017/dbname
